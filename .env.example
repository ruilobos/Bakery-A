# Copy to `.env` beside this file and fill in real values. `.env` is never
# committed (.gitignore). base.py reads it for host-side commands (runserver,
# pytest, manage.py), and docker-compose.yaml reads it for its ${...} values.
#
# Tasks 2.1, 2.3, 2.4 and 2.19 added these variables. 7.13 completes this file
# per environment (ADR-015 rule 8): names and example values only, never a real
# secret.

# Django's secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# URL-safe on purpose: compose reads `$` in this file as a variable reference.
SECRET_KEY=

# The compose postgres password. PostgreSQL sets it once, when the volume is
# created; an existing `bakery_pgdata` volume keeps the password it was created
# with, so repeat that one here. Use URL-safe characters: it is also part of the
# URLs below and in docker-compose.yaml.
POSTGRES_PASSWORD=

# The database for host-side commands: compose's postgres on its published port.
# Compose's `web` builds its own URL, naming the `postgres` service instead.
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5432/simple

# Task 2.19: base.py has no default for these either, so leave them filled in.
# local.py and test.py set their own, so these values reach only a command run on
# base.py itself, such as a bare `python manage.py`: keep them production's.
# Compose's `web` sets its own too. A host sets DEBUG=False and its own domains,
# comma-separated with no spaces.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Task 2.3: only for a host that serves the app on its own domain, so leave them
# out here. local.py and test.py fix their own values, and compose's `web` on
# http://localhost needs none. Unset, Django trusts no origin beyond the serving
# host and keeps cookies host-only.
#   CSRF_TRUSTED_ORIGINS   comma-separated bare hosts (Django 3.2's format, until
#                          19.4): bakery.example.com,.example.org
#   SESSION_COOKIE_DOMAIN  and CSRF_COOKIE_DOMAIN: .example.com shares the cookie
#                          with every subdomain
# CSRF_TRUSTED_ORIGINS=
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=

# Task 2.4: turns off base.py's HTTPS-only settings. docker-compose.yaml sets it for
# `web`, which serves http://localhost; never set it here or on a host. base.py
# reads this file, and until 7.6 adds a .dockerignore a local build copies it into
# the image, so a value here would reach both.
# INSECURE_LOCAL_HTTP=
